OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
MODEL_NAME=qwen/qwen-2.5-72b-instruct:free

# docker-compose.yaml reads these
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hermes
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me

# hermes-webui login, one var per profile (HERMES_WEBUI_PASSWORD_<NAME>).
# Add a matching line here for every new webui-<name> service.
HERMES_WEBUI_PASSWORD_PAN=change-me
